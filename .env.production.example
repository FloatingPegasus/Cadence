# Production values for cadence.kanishq.dev (always-on VM).
# Copy to .env on the host. Never commit the real .env.

CADENCE_DOMAIN=cadence.kanishq.dev
CADENCE_SECRET_KEY=replace-with-a-long-random-value
CADENCE_POSTGRES_DB=cadence
CADENCE_POSTGRES_USER=cadence
CADENCE_POSTGRES_PASSWORD=replace-with-a-strong-db-password

CADENCE_DATABASE_URL=postgresql+psycopg://cadence:replace-with-a-strong-db-password@localhost:5432/cadence
CADENCE_ALGORITHM=HS256
CADENCE_ACCESS_TOKEN_EXPIRE_MINUTES=10080

CADENCE_TEST_MODE=false
CADENCE_DEV_MODE=false
CADENCE_DEV_EMAIL=
CADENCE_DEV_PASSWORD=

CADENCE_AI_ENABLED=false
CADENCE_EMBEDDING_ENABLED=false

CADENCE_BREVO_API_KEY=replace-with-brevo-api-key
CADENCE_FROM_EMAIL=no-reply@cadence.kanishq.dev
CADENCE_FROM_NAME=Cadence

CADENCE_FRONTEND_BASE_URL=https://cadence.kanishq.dev
CADENCE_CORS_ORIGINS=https://cadence.kanishq.dev
CADENCE_SERVE_FRONTEND=true

CADENCE_AUTH_RATE_LIMIT_BACKEND=memory
CADENCE_BACKUP_RETENTION_COUNT=14
CADENCE_VERIFICATION_TOKEN_EXPIRE_HOURS=24
