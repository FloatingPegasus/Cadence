# Copy this file to .env for local development. Replace every value marked
# as a placeholder, and never commit .env or real credentials.

# Application and database
CADENCE_SECRET_KEY=replace-with-a-long-random-value
CADENCE_DATABASE_URL=sqlite+aiosqlite:///cadence/data/database.db
CADENCE_ALGORITHM=HS256
CADENCE_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Development switches
# Automated tests only. Keep false for normal local development.
CADENCE_TEST_MODE=false
# When enabled, these environment-only credentials create or reuse one verified
# local developer account. Keep disabled and leave both values empty normally.
CADENCE_DEV_MODE=false
CADENCE_DEV_EMAIL=
CADENCE_DEV_PASSWORD=

# Optional external summaries and model catalog
# Leave disabled unless you have configured a provider and understand what
# account data will be sent to it. Cadence keeps this feature off by default.
CADENCE_AI_ENABLED=false
CADENCE_AI_PROVIDER=nvidia
CADENCE_AI_BASE_URL=https://integrate.api.nvidia.com/v1
CADENCE_AI_API_KEY=replace-with-provider-api-key
CADENCE_AI_CATALOG_REFRESH_MINUTES=360
CADENCE_AI_REQUEST_TIMEOUT_SECONDS=45

# Email verification (optional for test mode)
CADENCE_BREVO_API_KEY=replace-with-brevo-api-key
CADENCE_FROM_EMAIL=replace-with-verified-sender@example.com
CADENCE_FROM_NAME=Cadence

# Frontend and cross-origin requests
CADENCE_FRONTEND_BASE_URL=http://localhost:3001
CADENCE_CORS_ORIGINS=http://localhost:3001
# Browser sessions use Secure cookies automatically over HTTPS. Plain HTTP is
# intended only for loopback development (for example, localhost).
CADENCE_SERVE_FRONTEND=false
CADENCE_FRONTEND_DIST_DIR=front/dist

# Backups and runtime locking
CADENCE_BACKUP_DIR=cadence/data/backups
CADENCE_BACKUP_RETENTION_COUNT=10
CADENCE_RUNTIME_LOCK_PATH=cadence/data/cadence.lock
CADENCE_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Authentication abuse protection. Memory is suitable for one process. Use the
# Redis backend for multiple workers or instances; it fails closed if Redis is
# unavailable rather than silently switching back to process-local state.
CADENCE_AUTH_RATE_LIMIT_BACKEND=memory
# CADENCE_REDIS_URL=redis://localhost:6379/0
CADENCE_REDIS_KEY_PREFIX=cadence:rate-limit
# Positive finite bounds prevent Redis connection or command calls from
# hanging indefinitely when the shared backend is unavailable.
CADENCE_REDIS_CONNECT_TIMEOUT_SECONDS=5
CADENCE_REDIS_SOCKET_TIMEOUT_SECONDS=5
CADENCE_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
CADENCE_AUTH_REGISTER_RATE_LIMIT=5
CADENCE_AUTH_LOGIN_RATE_LIMIT=10
CADENCE_AUTH_VERIFICATION_RATE_LIMIT=20
CADENCE_AUTH_VERIFICATION_RESEND_RATE_LIMIT=5
